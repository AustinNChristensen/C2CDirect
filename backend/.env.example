OPENAI_API_KEY=
C2CDIRECT_CONFIG_ENCRYPTION_KEY=
# Any OpenAI-compatible chat-completions server: Ollama, vLLM, LM Studio,
# LocalAI, or a hosted compatible endpoint. Leave deterministic for no model calls.
C2CDIRECT_MODEL_PROVIDER=deterministic
C2CDIRECT_MODEL_BASE_URL=
C2CDIRECT_MODEL_NAME=local-rules
C2CDIRECT_MODEL_API_KEY=
C2CDIRECT_MODEL_INPUT_COST_PER_MILLION=0
C2CDIRECT_MODEL_OUTPUT_COST_PER_MILLION=0
C2CDIRECT_MODEL_TIMEOUT_SECONDS=30
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/c2cdirect
N8N_WEBHOOK_SECRET=replace-me
N8N_CALLBACK_URL=
FRONTEND_ORIGIN=http://localhost:3000
SOURCE_URL=https://directc2c.com/#core
OTEL_EXPORTER_OTLP_ENDPOINT=
DAILY_AI_BUDGET_USD=10
MAX_RUN_COST_USD=0.10
MAX_RUN_TOKENS=12000
JWT_ISSUER=https://example.auth0.com/
JWT_AUDIENCE=c2cdirect-api
JWT_JWKS_URL=https://example.auth0.com/.well-known/jwks.json
TRUSTED_PROXY_IDENTITY_HEADER=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
OTEL_SERVICE_NAME=c2cdirect-api
TRACE_CONTENT_MODE=metadata_only

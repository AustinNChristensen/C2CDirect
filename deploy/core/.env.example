POSTGRES_PASSWORD=generated-by-setup
APP_DATABASE_PASSWORD=generated-by-setup
CORE_PORT=8080
AUTH_DISABLED_FOR_LOCAL_DEV=true
C2CDIRECT_CONFIG_ENCRYPTION_KEY=generated-by-setup
EMAIL_TOKEN_ENCRYPTION_KEY=generated-by-setup
SEARXNG_SECRET=generated-by-setup
COMPOSE_PROFILES=web-search
EMAIL_OAUTH_REDIRECT_BASE=http://127.0.0.1:8080/api/v1/email/oauth
GMAIL_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
SOURCE_URL=https://directc2c.com/#core

# Leave deterministic for a zero-cost local install. The setup assistant fills
# these for Ollama, vLLM, LM Studio, LocalAI, or another compatible endpoint.
C2CDIRECT_MODEL_PROVIDER=deterministic
C2CDIRECT_MODEL_BASE_URL=
C2CDIRECT_MODEL_NAME=local-rules
C2CDIRECT_MODEL_API_KEY=
C2CDIRECT_MODEL_INPUT_COST_PER_MILLION=0
C2CDIRECT_MODEL_OUTPUT_COST_PER_MILLION=0
C2CDIRECT_MODEL_TIMEOUT_SECONDS=30

DAILY_AI_BUDGET_USD=10
MAX_RUN_COST_USD=0.10
MAX_RUN_TOKENS=12000

FROM node:22-alpine AS build
WORKDIR /app
ARG NEXT_PUBLIC_SOURCE_URL=https://github.com/AustinNChristensen/C2CDirect
ENV NEXT_PUBLIC_SOURCE_URL=$NEXT_PUBLIC_SOURCE_URL
ARG NEXT_PUBLIC_SITE_URL=https://directc2c.com
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SHOW_EXPERIMENTAL_TABS=false
ENV NEXT_PUBLIC_SHOW_EXPERIMENTAL_TABS=$NEXT_PUBLIC_SHOW_EXPERIMENTAL_TABS
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY app ./app
COPY public ./public
COPY .openai ./.openai
COPY next.config.ts tsconfig.json vite.config.ts ./
RUN pnpm build

FROM node:22-alpine AS runtime
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
COPY --from=build --chown=app:app /app ./
USER app
EXPOSE 3000
CMD ["node", "node_modules/vinext/dist/cli.js", "start"]

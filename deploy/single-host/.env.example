APP_DOMAIN=example.com
SOURCE_URL=https://directc2c.com/#core
# Generate long URL-safe alphanumeric values so DATABASE_URL needs no escaping.
POSTGRES_PASSWORD=generatealongrandomurlsafevalue
APP_DATABASE_PASSWORD=generateaseparateappdatabasepassword
N8N_ENCRYPTION_KEY=generateadifferentlongrandomvalue
N8N_WEBHOOK_SECRET=generateathirdlongrandomvalue
MINIMUM_INGEST_SCORE=50
MCP_LOCAL_BEARER_TOKEN=generateafourthlongrandomvalue
# Local-only premium MCP smoke testing. This has no effect when OIDC auth is enabled.
MCP_ALLOW_LOCAL_PREMIUM_DEV=true
CLOUDFLARE_TUNNEL_TOKEN=
C2CDIRECT_BASIC_AUTH_HASH=generate-a-caddy-password-hash

# Encrypts OAuth access/refresh tokens at rest. Generate a Fernet key locally.
EMAIL_TOKEN_ENCRYPTION_KEY=generate-a-fernet-key-without-sharing-it
EMAIL_OAUTH_REDIRECT_BASE=http://127.0.0.1:8080/api/v1/email/oauth
# Register localhost redirect URLs with the chosen provider; never commit client credentials.
GMAIL_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=

# Keep true until Auth0 and tenant provisioning are configured and tested.
AUTH_DISABLED_FOR_LOCAL_DEV=true
JWT_ISSUER=
JWT_AUDIENCE=c2cdirect-api
JWT_JWKS_URL=

OPENAI_API_KEY=
C2CDIRECT_MODEL_PROVIDER=deterministic
C2CDIRECT_MODEL_BASE_URL=
C2CDIRECT_MODEL_NAME=local-rules
C2CDIRECT_MODEL_API_KEY=
C2CDIRECT_MODEL_INPUT_COST_PER_MILLION=0
C2CDIRECT_MODEL_OUTPUT_COST_PER_MILLION=0
C2CDIRECT_MODEL_TIMEOUT_SECONDS=30
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=c2cdirect-api
TRACE_CONTENT_MODE=metadata_only
DAILY_AI_BUDGET_USD=10
MAX_RUN_COST_USD=0.10
MAX_RUN_TOKENS=12000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
